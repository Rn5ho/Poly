# Poly Bot — Environment Variables
#
# Copy to /opt/poly/.env (or export in shell)
#
# Telegram notifications (required for alerts)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-token-here
TELEGRAM_CHAT_ID=987654321

# Polymarket live trading (only needed for --live mode)
# Get from your Polygon wallet
# POLY_PRIVATE_KEY=0x...
# POLY_FUNDER=0x...
